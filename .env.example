# Telegram MTProto credentials (https://my.telegram.org/apps)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

# Dropbox OAuth2 app credentials. Use a refresh token, not an access token.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_PATH=/telegram_2_dropbox

# Comma-separated Telegram user IDs allowed to upload.
# Leave empty to deny everyone (the bot replies with the sender's ID).
ALLOWED_USER_IDS=

# Optional tuning
# 4-148 MiB, multiple of 4. Larger chunks mean fewer Dropbox round trips but
# use roughly 2x the chunk size in memory. 148 is the max safe value because
# Dropbox caps a request at 150 MiB and non-final chunks must be 4 MiB aligned.
UPLOAD_CHUNK_SIZE_MB=4
# Files up to this size use a single files_upload request (max 150 MiB).
SMALL_FILE_THRESHOLD_MB=8
MAX_RETRIES=6
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0

# Telethon session file (gitignored)
SESSION_NAME=bot_session
